{
  "name": "gokognito",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "worker": "tsx --env-file=.env src/worker/index.ts",
    "e2e": "tsx --env-file=.env src/scripts/e2e-smoke.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "db:seed:real": "tsx --env-file=.env src/db/seed-real-brokers.ts",
    "db:seed:self": "tsx --env-file=.env src/db/seed-self-profile.ts",
    "db:seed:loopback": "tsx --env-file=.env src/db/seed-loopback-broker.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "drizzle-orm": "^0.45.2",
    "gsap": "3.12.5",
    "lenis": "1.1.14",
    "next": "16.2.6",
    "pdf-parse": "^2.4.5",
    "pg-boss": "^12.18.2",
    "postgres": "^3.4.9",
    "postmark": "^4.0.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.160.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.160.0",
    "@vitest/ui": "^4.1.7",
    "drizzle-kit": "^0.31.10",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
