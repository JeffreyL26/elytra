# PostgreSQL-Verbindung (Zugangsdaten siehe docker-compose.yml)
DATABASE_URL="postgresql://inkognigo:inkognigo@localhost:5432/inkognigo"

# Anthropic API (Inbound-Klassifikation im Worker; Web-Prozess braucht ihn nicht)
ANTHROPIC_API_KEY=sk-ant-...

# Postmark Outbound (Server-API-Token)
POSTMARK_SERVER_TOKEN=""

# Mail-Domains und -Adressen (Rebrand = nur hier aendern, nie hartcodieren)
MAIL_FROM_ADDRESS="removals@jba-team.com"
MAIL_FROM_DOMAIN="jba-team.com"
REPLY_DOMAIN="reply.jba-team.com"

# Postmark Inbound-Webhook (HTTP Basic Auth)
POSTMARK_INBOUND_WEBHOOK_USERNAME=""
POSTMARK_INBOUND_WEBHOOK_PASSWORD=""

# Better Auth (Multi-Tenant Schritt 2). Secret >= 32 Zeichen (z. B.
# `openssl rand -base64 32`); URL ist die oeffentliche Basis-URL fuer Verify-Links.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Customer-Message-Stream (Reputationstrennung: NIE der Broker-Stream). Solange
# leer, laufen Verifizierungs-/Kundenmails im LOG-MODUS (werden nicht versendet,
# nur laut geloggt) -- Aktivierung des Echtversands ist dann ein reiner
# Config-Schritt. POSTMARK_CUSTOMER_STREAM = Message-Stream-ID des in Postmark
# angelegten Customer-Streams; MAIL_CUSTOMER_FROM_ADDRESS = getrennte From-Adresse
# fuer Kundenmails (nicht removals@, das gehoert dem Broker-Stream).
POSTMARK_CUSTOMER_STREAM=""
MAIL_CUSTOMER_FROM_ADDRESS=""

# Self-Request-Testprofil — nur lokal in .env befuellen (pnpm db:seed:self).
# KEINE echten personenbezogenen Daten committen.
SELF_NAME=""
SELF_STREET=""
SELF_POSTAL_CODE=""
SELF_CITY=""
# SELF_EMAIL: Absenderadresse (From) des Self-Requests.
SELF_EMAIL=""
# SELF_IDENTITY_EMAILS: kommaseparierte Identifikationsadressen fuers Profil
# (Adressen, unter denen Broker die Person kennen). Leer -> Fallback SELF_EMAIL.
SELF_IDENTITY_EMAILS=""
