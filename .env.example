# PostgreSQL-Verbindung (Zugangsdaten siehe docker-compose.yml)
DATABASE_URL="postgresql://inkognigo:inkognigo@localhost:5432/inkognigo"

# Anthropic API (Inbound-Klassifikation im Worker; Web-Prozess braucht ihn nicht)
ANTHROPIC_API_KEY=sk-ant-...

# Postmark Outbound (Server-API-Token)
POSTMARK_SERVER_TOKEN=""

# Mail-Domains und -Adressen (Rebrand = nur hier aendern, nie hartcodieren)
MAIL_FROM_ADDRESS="removals@jba-team.com"
MAIL_FROM_DOMAIN="jba-team.com"
REPLY_DOMAIN="reply.jba-team.com"

# Postmark Inbound-Webhook (HTTP Basic Auth)
POSTMARK_INBOUND_WEBHOOK_USERNAME=""
POSTMARK_INBOUND_WEBHOOK_PASSWORD=""

# Self-Request-Testprofil — nur lokal in .env befuellen (pnpm db:seed:self).
# KEINE echten personenbezogenen Daten committen.
SELF_NAME=""
SELF_STREET=""
SELF_POSTAL_CODE=""
SELF_CITY=""
SELF_EMAIL=""
